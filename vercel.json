{
  "version": 2,
  "builds": [
    {
      "src": "index.php",
      "use": "vercel-php@0.7.0",
      "config": {
        "includeFiles": ["index/**"]
      }
    },
    {
      "src": "index/vista/assets/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/index/vista/assets/$1"
    },
    {
      "src": "/index/vista/assets/(.*)",
      "dest": "/index/vista/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.php"
    }
  ]
}
