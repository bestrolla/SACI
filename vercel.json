{
  "version": 2,
  "builds": [
    {
      "src": "**/*.php",
      "use": "vercel-php@0.7.0"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/index/vista/assets/$1"
    },
    {
      "src": "^/$",
      "dest": "/index/vista/home.php"
    },
    {
      "src": "/(home|resumen|deudas|nueva_deuda|pagos|clientes|registrar_tasa|orden|tema)\\.php",
      "dest": "/index/vista/$1.php"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
